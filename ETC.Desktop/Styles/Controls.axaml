<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ETC.Desktop.Controls">

  <!-- Hanken Grotesk: proporsi dekat SF Pro dan tetap terbaca di 13px (ukuran body desktop HIG). -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.group">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection.Bg}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line.Hairline}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.InsetHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Primary.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Primary.Fg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary.BgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Primary.Fg}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Primary.Fg}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Danger.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger.Fg}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger.Fg}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.success">
    <Setter Property="Background" Value="{DynamicResource Success.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Success.Fg}" />
  </Style>
  <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Success.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Success.Fg}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="30" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
  </Style>
  <Style Selector="Button.row:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection.Bg}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Selection.Fg}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="32,7,10,7" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.InsetHover}" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="CalendarDatePicker">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
  </Style>

  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="Margin" Value="0,5,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.error">
    <Setter Property="Background" Value="{DynamicResource Danger.Bg}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.error > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Danger.Fg}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="seg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextElement.FontWeight="Medium" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#seg">
    <Setter Property="Background" Value="{DynamicResource Bg.InsetHover}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#seg">
    <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Raised}" />
  </Style>

  <Style Selector="RadioButton.nav">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="row" Background="Transparent" CornerRadius="7" Padding="10,0" Height="32">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#row">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#row">
    <Setter Property="Background" Value="{DynamicResource Selection.Bg}" />
  </Style>
  <Style Selector="RadioButton.nav c|Glyph">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="RadioButton.nav:checked c|Glyph">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="RadioButton.nav:checked TextBlock.navlabel">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Selection.Fg}" />
  </Style>

  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource Marker.Bg}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.count > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Marker.Fg}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,5,5" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Border.chip.match">
    <Setter Property="Background" Value="{DynamicResource Marker.Soft}" />
  </Style>
  <Style Selector="Border.chip.match > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selection.Bg}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selection.Bg}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Fg}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>
</Styles>
