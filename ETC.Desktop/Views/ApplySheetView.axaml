<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ETC.Desktop.ViewModels"
             x:Class="ETC.Desktop.Views.ApplySheetView"
             x:DataType="vm:ApplySheetViewModel">
  <StackPanel Margin="28,26" Spacing="16">
    <StackPanel Spacing="3">
      <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" Text="{Binding Subtitle}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="field" Text="Tautan CV" />
      <TextBox Text="{Binding CvUrl}" Watermark="https://drive.google.com/..." />
      <TextBlock Classes="hint" Text="Pastikan tautan bisa dibuka oleh siapa saja yang memiliki link." />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="field" Text="Tautan portofolio" />
      <TextBox Text="{Binding PortofolioUrl}" Watermark="https://github.com/..." />
    </StackPanel>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="field" Text="Kenapa Anda cocok? (opsional)" />
        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AlasanCount}" />
      </Grid>
      <TextBox Text="{Binding Alasan}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxLength="500" />
    </StackPanel>
    <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Error}" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Batal" Command="{Binding CancelCommand}" />
      <Button Classes="primary" Content="Kirim lamaran" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </StackPanel>
</UserControl>
