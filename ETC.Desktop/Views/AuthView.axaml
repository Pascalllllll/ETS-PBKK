<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ETC.Desktop.ViewModels"
             xmlns:v="using:ETC.Desktop.Views"
             xmlns:c="using:ETC.Desktop.Controls"
             x:Class="ETC.Desktop.Views.AuthView"
             x:DataType="vm:AuthViewModel">
  <Grid ColumnDefinitions="5*,6*">
    <Border Grid.Column="0" Background="#0E2039">
      <Grid RowDefinitions="Auto,*,Auto" Margin="48,44">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Background="#FFFFFF" CornerRadius="10" Width="40" Height="40" Padding="5">
            <Image Source="avares://ETC/Assets/etc-logo.png" />
          </Border>
          <TextBlock Text="Elite TC Champions" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18" MaxWidth="420" HorizontalAlignment="Left">
          <TextBlock Foreground="#FFFFFF" FontSize="38" FontWeight="ExtraBold" LineHeight="44" LetterSpacing="-0.6" TextWrapping="Wrap">
            <Run Text="Cari tim untuk lomba, riset, dan projek" />
            <Run Text="di satu tempat." Foreground="#F5C531" />
          </TextBlock>
          <TextBlock Foreground="#C9D3E3" FontSize="15" LineHeight="23" TextWrapping="Wrap"
                     Text="Buka rekrutmen, temukan partner lintas jurusan berdasarkan keahlian, dan lihat ulasan rekan tim sebelumnya sebelum memutuskan." />
        </StackPanel>

        <TextBlock Grid.Row="2" Foreground="#AEBBD0" FontSize="12" TextWrapping="Wrap"
                   Text="Tim 3 ·Hosea Felix Sanjaya, Muhammad Abid Baihaqi Al Faridzi, Lyonel Oliver Dwiputra" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Grid MinHeight="600">
        <StackPanel IsVisible="{Binding IsLogin}" Width="360" VerticalAlignment="Center" Spacing="18" Margin="0,40">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Masuk ke ETC" />
            <TextBlock Classes="secondary" Text="Gunakan NRP dan kata sandi akun ETC Anda." TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="field" Text="NRP" />
            <TextBox x:Name="LoginIdBox" Text="{Binding LoginId}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="field" Text="Kata sandi" />
            <TextBox Text="{Binding LoginPassword}" PasswordChar="•" RevealPassword="False">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </StackPanel>

          <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" />
          </Border>

          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="36"
                  Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" Content="Masuk" IsDefault="True" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <TextBlock Classes="secondary" Text="Belum punya akun?" VerticalAlignment="Center" />
            <Button Classes="plain" Content="Buat akun" Command="{Binding ShowRegisterCommand}" />
          </StackPanel>

          <Border Classes="hairline" Margin="0,4" />
          <StackPanel Spacing="8">
            <TextBlock Classes="group" Text="Data demo" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DemoHint}" />
            <Button Content="Isi akun demo" Command="{Binding FillDemoCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsRegister}" Width="400" VerticalAlignment="Center" Spacing="18" Margin="0,40">
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{Binding StepText}" />
            <TextBlock Classes="h1" Text="{Binding StepTitle}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="16" IsVisible="{Binding IsStep1}">
            <StackPanel>
              <TextBlock Classes="field" Text="Nama lengkap" />
              <TextBox Text="{Binding Nama}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="field" Text="NRP" />
              <TextBox Text="{Binding NoPengenal}" Watermark="10 digit, contoh 5025241XXX" />
              <TextBlock Classes="hint" Text="Dipakai untuk masuk dan ditampilkan ke pembuat rekrutmen saat Anda melamar." />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="16" IsVisible="{Binding IsStep2}">
            <StackPanel>
              <TextBlock Classes="field" Text="Departemen" />
              <ComboBox ItemsSource="{Binding JurusanOptions}" SelectedItem="{Binding Jurusan}" PlaceholderText="Pilih departemen" />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="field" Text="Nomor WhatsApp" />
              <TextBox Text="{Binding NoTelp}" Watermark="08xxxxxxxxxx" />
              <TextBlock Classes="hint" Text="Hanya terlihat oleh rekan satu tim dan pembuat rekrutmen yang Anda lamar." />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="16" IsVisible="{Binding IsStep3}">
            <StackPanel>
              <TextBlock Classes="field" Text="Keahlian" />
              <v:TagEditor DataContext="{Binding Skills}" />
              <TextBlock Classes="hint" Text="Dipakai untuk mencocokkan Anda dengan rekrutmen. Bisa diubah nanti di Profil." />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="field" Text="Kata sandi" />
              <TextBox Text="{Binding Password}" PasswordChar="•" />
              <TextBlock Classes="hint" Text="Minimal 8 karakter." />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="field" Text="Ulangi kata sandi" />
              <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding RegisterCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
          </StackPanel>

          <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" />
          </Border>

          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Content="Kembali" Command="{Binding BackCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Lanjut" Command="{Binding NextCommand}" IsVisible="{Binding !IsStep3}" />
            <Button Grid.Column="2" Classes="primary" Content="Buat akun" Command="{Binding RegisterCommand}"
                    IsVisible="{Binding IsStep3}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
