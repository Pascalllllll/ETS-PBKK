<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ETC.Desktop.ViewModels"
             x:Class="ETC.Desktop.Views.ConfirmSheetView"
             x:DataType="vm:ConfirmSheetViewModel">
  <StackPanel Margin="28,26" Spacing="14">
    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20" />
    <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Error}" />
    </Border>
    <!-- Batal menjadi default agar Enter tidak memicu aksi destruktif. -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Batal" Command="{Binding CancelCommand}" IsDefault="True" />
      <Button Classes="danger" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </StackPanel>
</UserControl>
