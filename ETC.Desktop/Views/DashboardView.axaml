<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ETC.Desktop.ViewModels"
             xmlns:s="using:ETC.Desktop.Services"
             xmlns:v="using:ETC.Desktop.Views"
             xmlns:c="using:ETC.Desktop.Controls"
             x:Class="ETC.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Grid>
    <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="240">
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Classes="caption" Text="Menghitung ringkasan dari data rekrutmen" HorizontalAlignment="Center" />
    </StackPanel>

    <Border Classes="card" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Ringkasan belum bisa ditampilkan" />
        <TextBlock Classes="secondary" Text="{Binding Error}" TextWrapping="Wrap" />
        <Button Classes="primary" Content="Muat ulang" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <ScrollViewer IsVisible="{Binding Data, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Margin="36,8,36,40" MaxWidth="1200" Spacing="28">

        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Classes="caption" Text="{Binding Today}" />
          <TextBlock Classes="display" Text="{Binding Greeting}" />
          <TextBlock FontSize="17" LineHeight="26" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" MaxWidth="780" HorizontalAlignment="Left"><Run Text="{Binding HeadlineA}" Background="{DynamicResource Marker.Bg}" Foreground="{DynamicResource Marker.Fg}" FontWeight="Bold" /><Run Text="{Binding HeadlineARest}" /><Run Text="{Binding HeadlineB}" />
          </TextBlock>
        </StackPanel>

        <Grid ColumnDefinitions="3*,24,2*">
          <Border Classes="card" Padding="12,18,12,12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" Margin="8,0,8,6">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="Perlu keputusan Anda" />
                  <TextBlock Classes="caption" Text="Pelamar terlama ditampilkan lebih dulu." />
                </StackPanel>
                <Button Grid.Column="1" Classes="plain" Content="Semua pelamar" Command="{Binding OpenAllApplicantsCommand}"
                        VerticalAlignment="Top" />
              </Grid>

              <ItemsControl ItemsSource="{Binding PerluKeputusan}" IsVisible="{Binding HasPerluKeputusan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingRow">
                    <Border Padding="8,10" BorderBrush="{DynamicResource Line.Hairline}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Selection.Bg}" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Selection.Fg}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                          <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" />
                          <TextBlock Classes="secondary" FontSize="12" Text="{Binding Judul}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                            <Border Classes="chip" Classes.match="{Binding StrongMatch}" Margin="0" IsVisible="{Binding MatchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding MatchText}" />
                            </Border>
                            <TextBlock Classes="caption" Text="{Binding Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="plain" Content="Profil"
                                  Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenApplicantCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Nama, StringFormat='Lihat profil {0}'}" />
                          <Button Classes="danger" Content="Tolak"
                                  Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).RejectCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Nama, StringFormat='Tolak {0}'}" />
                          <Button Classes="success" Content="Terima"
                                  Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AcceptCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Nama, StringFormat='Terima {0}'}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="plain" Content="{Binding PerluKeputusanMore}" IsVisible="{Binding HasPerluKeputusanMore}"
                      Command="{Binding OpenAllApplicantsCommand}" Margin="4,0" />

              <StackPanel IsVisible="{Binding !HasPerluKeputusan}" Spacing="10" Margin="8,14,8,10">
                <c:Glyph Data="{StaticResource Icon.InboxFill}" Size="28" Foreground="{DynamicResource Text.Tertiary}" />
                <TextBlock Classes="h3" Text="Tidak ada pelamar yang menunggu" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Pelamar baru di rekrutmen Anda akan muncul di sini. Butuh anggota tim? Buka rekrutmen dengan tombol di kanan atas (Ctrl+N)." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card" Padding="12,18,12,8">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="Posisi Anda" Margin="8,0,8,10" />
              <Button Classes="row" Command="{Binding OpenApplicationsCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lamaran menunggu" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="Belum diputuskan oleh pembuat rekrutmen" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="metric" Text="{Binding Data.LamaranMenunggu}" />
                </Grid>
              </Button>
              <Border Classes="hairline" Margin="10,0" />
              <Button Classes="row" Command="{Binding OpenTeamsCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tim aktif" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="Kegiatan yang belum selesai" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="metric" Text="{Binding Data.TimAktif}" />
                </Grid>
              </Button>
              <Border Classes="hairline" Margin="10,0" />
              <Button Classes="row" Command="{Binding EditProfileCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rating dari rekan tim" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding RatingCaption}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <c:Glyph Data="{StaticResource Icon.StarFill}" Size="18" Foreground="{DynamicResource Marker.Bg}" VerticalAlignment="Center" />
                    <TextBlock Classes="metric" Text="{Binding RatingText}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Border Classes="hairline" Margin="10,0" />
              <Button Classes="row" Command="{Binding ExploreCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rekrutmen terbuka di ETC" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="Semua kegiatan yang masih menerima pelamar" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="metric" Text="{Binding Data.RekrutmenTerbuka}" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="3*,24,2*">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="Cocok dengan keahlian Anda" />
                <TextBlock Classes="caption" Text="Rekrutmen terbuka yang meminta keahlian di profil Anda. Keahlian yang cocok ditandai." />
              </StackPanel>
              <Button Grid.Column="1" Classes="plain" Content="Jelajahi semua" Command="{Binding ExploreCommand}" VerticalAlignment="Top" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Rekomendasi}" IsVisible="{Binding HasRekomendasi}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecommendationRow">
                  <Button Classes="row" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Line.Hairline}"
                          BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,12,12" VerticalAlignment="Stretch"
                          VerticalContentAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenRekrutmenCommand}"
                          CommandParameter="{Binding Row}">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Glyph Data="{Binding Row.KegiatanIcon, Converter={x:Static v:IconConverter.Instance}}" Size="15"
                                 Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding Row.KegiatanLabel}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="·" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding Row.DeadlineText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Danger.Fg}" IsVisible="{Binding Row.Urgent}" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="{Binding Row.DeadlineText}" VerticalAlignment="Center" IsVisible="{Binding !Row.Urgent}" />
                      </StackPanel>
                      <StackPanel Spacing="1">
                        <TextBlock Classes="h3" Text="{Binding Row.Role}" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding Row.Judul}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SkillChip">
                            <Border Classes="chip" Classes.match="{Binding Match}">
                              <TextBlock Text="{Binding Name}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Text="{Binding Row.Pembuat}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card" IsVisible="{Binding !HasRekomendasi}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Belum ada yang cocok" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Rekomendasi diambil dari keahlian di profil Anda. Tambahkan keahlian seperti bahasa pemrograman atau alat desain yang Anda kuasai." />
                <Button Content="Tambah keahlian di profil" Command="{Binding EditProfileCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="Tutup dalam 14 hari" />
              <TextBlock Classes="caption" Text="Rekrutmen orang lain yang segera berhenti menerima pelamar." />
            </StackPanel>
            <Border Classes="card" Padding="8">
              <Panel>
                <ItemsControl ItemsSource="{Binding TutupSegera}" IsVisible="{Binding HasTutupSegera}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RekrutmenRow">
                      <Button Classes="row" Padding="10,9"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenRekrutmenCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Judul}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
                            <c:Glyph Data="{StaticResource Icon.BookmarkFill}" Size="14" Foreground="{DynamicResource Accent}"
                                     IsVisible="{Binding IsBookmarked}" ToolTip.Tip="Tersimpan" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DeadlineText}"
                                       Foreground="{DynamicResource Danger.Fg}" IsVisible="{Binding Urgent}" />
                            <TextBlock FontSize="12" Text="{Binding DeadlineText}" Foreground="{DynamicResource Text.Secondary}"
                                       IsVisible="{Binding !Urgent}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding !HasTutupSegera}" Classes="secondary" Margin="10" TextWrapping="Wrap"
                           Text="Tidak ada rekrutmen yang tutup dalam dua minggu ke depan." />
              </Panel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="3*,24,2*">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="Rekrutmen baru per bulan" />
                  <TextBlock Classes="caption" Text="{Binding PerBulanCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding ShowTable}" Content="Tabel" VerticalAlignment="Top"
                              ToolTip.Tip="Tampilkan angka sebagai tabel" CornerRadius="7" />
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,14">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Legend.Lomba}" VerticalAlignment="Center" />
                  <TextBlock FontSize="12" Text="Lomba" Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Legend.Riset}" VerticalAlignment="Center" />
                  <TextBlock FontSize="12" Text="Riset" Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Legend.Projek}" VerticalAlignment="Center" />
                  <TextBlock FontSize="12" Text="Projek" Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
              </StackPanel>
              <c:MonthlyStackedChart Grid.Row="2" Items="{Binding Data.PerBulan}" MinHeight="240" IsVisible="{Binding !ShowTable}" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Data.PerBulan}" IsVisible="{Binding ShowTable}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="s:MonthBucket">
                    <Grid ColumnDefinitions="2*,*,*,*,*" Margin="0,3">
                      <TextBlock Text="{Binding FullLabel}" FontSize="12" />
                      <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Lomba, StringFormat='Lomba {0}'}" Foreground="{DynamicResource Text.Secondary}" />
                      <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Riset, StringFormat='Riset {0}'}" Foreground="{DynamicResource Text.Secondary}" />
                      <TextBlock Grid.Column="3" FontSize="12" Text="{Binding Projek, StringFormat='Projek {0}'}" Foreground="{DynamicResource Text.Secondary}" />
                      <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Text="{Binding Total, StringFormat='Total {0}'}" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <StackPanel Grid.Column="2" Spacing="24">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="Keahlian paling dicari" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="Jumlah rekrutmen terbuka yang meminta keahlian tersebut. Tanda centang berarti ada di profil Anda." />
                </StackPanel>
                <c:SkillDemandChart Items="{Binding Data.KeahlianDicari}" IsVisible="{Binding HasKeahlian}" />
                <TextBlock Classes="secondary" IsVisible="{Binding !HasKeahlian}" Text="Belum ada rekrutmen terbuka." />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="h2" Text="Keputusan lamaran" />
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Pelamar di rekrutmen Anda" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Data.PelamarSaya.Total, StringFormat='{}{0} total'}" />
                  </Grid>
                  <c:StatusMeter Value="{Binding Data.PelamarSaya}" Height="10" />
                  <v:StatusLegend DataContext="{Binding Data.PelamarSaya}" IsVisible="{Binding $parent[v:DashboardView].((vm:DashboardViewModel)DataContext).HasPelamarSaya}" />
                  <TextBlock Classes="caption" Text="Belum ada pelamar." IsVisible="{Binding !HasPelamarSaya}" />
                </StackPanel>
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Lamaran yang Anda kirim" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Data.LamaranSaya.Total, StringFormat='{}{0} total'}" />
                  </Grid>
                  <c:StatusMeter Value="{Binding Data.LamaranSaya}" Height="10" />
                  <v:StatusLegend DataContext="{Binding Data.LamaranSaya}" IsVisible="{Binding $parent[v:DashboardView].((vm:DashboardViewModel)DataContext).HasLamaranSaya}" />
                  <TextBlock Classes="caption" Text="Anda belum pernah melamar." IsVisible="{Binding !HasLamaranSaya}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
